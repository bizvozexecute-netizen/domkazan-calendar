server {
  listen 80 default_server;
  listen [::]:80 default_server;
  server_name ${SERVER_IP};
  access_log off;
  error_log /var/log/nginx/domkazan-error.log crit;
  location ^~ /.well-known/acme-challenge/ { root /var/www/acme; }
  location / { return 308 https://${SERVER_IP}$request_uri; }
}
server {
  listen 443 ssl default_server;
  listen [::]:443 ssl default_server;
  server_name ${SERVER_IP};
  ssl_certificate /etc/letsencrypt/live/domkazan-ip/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/domkazan-ip/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:DomKazanTLS:1m;
  client_max_body_size 16k;
  client_body_timeout 10s;
  access_log off;
  error_log /var/log/nginx/domkazan-error.log crit;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy same-origin always;
  # Public catalog and requests have independent, explicit release flags.
  # Internal retry, test pages and other unlisted paths remain private.
  location = /api/health { proxy_pass http://127.0.0.1:3000; }
  location /api/internal/ { return 404; }
  location = /privacy { return 302 /privacy-2026-10-26.html; }
  location ~ ^/(?:privacy|consent)-2026-10-26\.html$ {
    root /var/www/domkazan;
    try_files $uri =404;
    default_type text/html;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
  }
  ${PUBLIC_ASSETS_LOCATION}
  location / {
    return 404;
  }
  location ~ ^/(?:admin(?:/|$)|api/admin(?:/|$)|_next/${PUBLIC_API_PATTERN}) {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host ${SERVER_IP};
    proxy_set_header X-Forwarded-Host ${SERVER_IP};
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Real-IP "";
    proxy_set_header X-DomKazan-Client-IP $remote_addr;
    proxy_set_header X-DomKazan-Proxy-Secret ${TRUSTED_PROXY_SECRET};
    proxy_buffering off;
    proxy_read_timeout 60s;
  }
}
